# Optional environment variables (no settings are required for local dev or Vercel).
# Note: Vercel automatically provides VERCEL, VERCEL_URL, and VERCEL_PROJECT_PRODUCTION_URL.

# Backend (FastAPI)
# Path to the SQLite file. Defaults to backend/patients.db locally, or /tmp/patients.db on Vercel.
# DATABASE_PATH=patients.db

# Comma-separated CORS origins allowed to call the backend API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite) — Vite reads VITE_* variables from frontend/.env or the build environment.
# Defaults to http://127.0.0.1:8000 in dev and /api in production builds.
VITE_API_URL=http://127.0.0.1:8000
